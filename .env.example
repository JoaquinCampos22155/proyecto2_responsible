# Local emulator defaults only. Use an ignored production env file for Project 2.
FIREBASE_PROJECT_ID=demo-project2-responsible
FIREBASE_STORAGE_BUCKET=demo-project2-responsible.appspot.com
# Comma-separated exact browser origins; configure production domain before launch.
CORS_ORIGINS=http://localhost:5173
AI_BUDGET_USD=20
# Defaults are offline mocks. Enable live providers only with server-side keys.
AI_PROVIDER=mock
# Optional: AI_PROVIDER=gemini uses gemini-3.5-flash-lite.
GEMINI_API_KEY=
IMAGE_PROVIDER=mock-stock
# Optional: IMAGE_PROVIDER=pexels.
PEXELS_API_KEY=
