    "@tanstack/react-query": "^5.90.0",
    "d3-geo": "^3.1.1",
    "firebase": "^12.19.0",
    "gsap": "^3.15.0",
    "i18n-iso-countries": "^7.14.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.0",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.64.0",
