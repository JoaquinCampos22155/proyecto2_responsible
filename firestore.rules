rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.admin == true; }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || admin());
      allow list: if admin();
      allow write: if false;
    }
    match /news/{articleId} {
      allow get: if signedIn() && (resource.data.status == 'published' || admin());
      allow list: if admin();
      allow write: if false;
    }
    match /userEvents/{eventId} {
      allow get: if signedIn() && (resource.data.uid == request.auth.uid || admin());
      allow list: if admin();
      allow write: if false;
    }
    match /audit/{id} {
      allow read: if admin();
      allow write: if false;
    }
    match /apiUsage/{id} {
      allow read: if admin();
      allow write: if false;
    }
  }
}
